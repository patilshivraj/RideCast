<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Minimal XML theme used only as the Activity window background before
        Compose renders. The real Material You theme is applied in RideCastTheme.kt.

        android:Theme.Material.Light.NoActionBar requires no extra dependencies
        and is available on all API levels we support (minSdk 26).
    -->
    <style name="Theme.RideCast" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Transparent system bars — edge-to-edge is managed by enableEdgeToEdge() -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
